{
  "name": "Toledo Citizen Platform",
  "platform_version": "0.2.0",
  "release_status": "pre-alpha executable reference release",
  "release_date": "2026-09-11",
  "protocol": "toledo-citizen",
  "protocol_version": "0.4.0",
  "runtime_version": "0.5.0",
  "repository": "https://github.com/morrocwi/toledo.biz",
  "release_notes": "docs/releases/v0.2.0.md",
  "mathematical_authority": "https://github.com/morrocwi/toledo",
  "equation_registry": {
    "path": "registry/equation-index.json",
    "upstream_path": "registry/proposals/TOLEDO_CITIZEN_BRIDGE_v0.17.json",
    "upstream_commit": "361546c934829de56f3dcff2032c740209de847a",
    "status": "proposal"
  },
  "problem_grammar": {
    "normative_doc": "docs/PROBLEM_CAPABILITY_GRAMMAR.md",
    "signature_schema": "packages/schemas/problem-signature.schema.json",
    "rule": "occupation/practice context is context, not a bespoke core protocol selector"
  },
  "decision_threads": {
    "normative_doc": "docs/DECISION_THREADS.md",
    "schema": "packages/schemas/decision-thread.schema.json",
    "rule": "one Case Passport may contain multiple decision-specific P0-P11 subgraphs while preserving primary-thread projection compatibility"
  },
  "case_lifecycle": {
    "mode": "stateless-reference",
    "passport_schema": "packages/schemas/case-passport.schema.json",
    "event_schema": "packages/schemas/case-event.schema.json",
    "step_request_schema": "packages/schemas/case-step-request.schema.json",
    "step_response_schema": "packages/schemas/case-step-response.schema.json",
    "normative_doc": "docs/CASE_LIFECYCLE.md",
    "local_closure": "allowed when no external actor was used, outcome closes, and safety/authority constraints are satisfied",
    "external_closure": "requires Return Gate PASS plus citizen outcome"
  },
  "api": {
    "openapi": "openapi/toledo.protocol.v1.yaml",
    "implementation": "apps/protocol_api/main.py",
    "case_step_endpoint": "/v1/cases/step",
    "thread_compile_endpoint": "/v1/cases/threads/compile",
    "problem_signature_schema_endpoint": "/v1/schemas/problem-signature",
    "decision_thread_schema_endpoint": "/v1/schemas/decision-thread"
  },
  "mcp": {
    "transport": "stdio",
    "implementation": "apps/mcp_server/server.py",
    "closed_loop_tools": ["initialize_case", "update_case", "advance_case", "compile_case_threads"],
    "problem_grammar_resource": "toledo://protocol/problem-capability-grammar",
    "decision_threads_resource": "toledo://protocol/decision-threads",
    "problem_signature_resource": "toledo://schema/problem-signature",
    "decision_thread_resource": "toledo://schema/decision-thread"
  },
  "ai_index": "llms.txt"
}
