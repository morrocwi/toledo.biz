{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toledo.biz/schemas/protocol-instance.schema.json",
  "title": "Toledo Protocol Instance",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol_id","protocol_version","phase","citizen_problem","status","next_action","hard_gates","equation_refs","return_requirement"],
  "properties": {
    "protocol_id": {"type": "string", "pattern": "^tp-[a-f0-9]{16}$"},
    "protocol_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "phase": {"type": "string", "enum": ["P0","P1","P2","P3","P4","P5","P6","P7","P8","P9","P10","P11"]},
    "citizen_problem": {"type": "string"},
    "status": {"type": "string", "enum": ["ACTIONABLE","HOLD_FOR_ESCALATION","HOLD_FOR_RETURN","HOLD_FOR_DEPENDENCY","CLOSED"]},
    "next_action": {"type": "string"},
    "hard_gates": {"type": "object"},
    "known": {"type": "array", "items": {"type": "string"}},
    "unknown": {"type": "array", "items": {"type": "string"}},
    "execution_routing": {"type": "object"},
    "execution_requirements": {"type": "array", "items": {"type": "object"}},
    "institution_candidates": {"type": "array", "items": {"type": "object"}},
    "equation_refs": {"type": "array", "items": {"type": "string"}},
    "return_requirement": {"type": "string"},
    "dependency_blocked": {"type": "boolean"},
    "dependency_reasons": {"type": "array", "items": {"type": "string"}},
    "thread_id": {"type": ["string", "null"], "pattern": "^td-[a-f0-9]{16}$"},
    "decision": {"type": ["string", "null"]},
    "thread_status": {"type": ["string", "null"], "enum": ["OPEN","HOLD","BLOCKED","CLOSED","CANCELLED",null]},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "blocking_threads": {"type": "array", "items": {"type": "string"}},
    "required_for_case_closure": {"type": "boolean"},
    "case_id": {"type": ["string", "null"]},
    "case_passport_version": {"type": ["integer", "null"], "minimum": 1},
    "outcome_state": {"type": ["string", "null"]},
    "failed_routes": {"type": "array", "items": {"type": "string"}}
  }
}
