{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toledo.biz/schemas/case-passport.schema.json",
  "title": "Toledo Case Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "version",
    "case_status",
    "jurisdiction",
    "citizen_problem_verbatim",
    "citizen_goal",
    "goal_state",
    "current_phase",
    "current_decision",
    "decision_threads",
    "primary_thread_id",
    "consent",
    "case_steward",
    "latest_return_gate",
    "outcome_state",
    "return_obligation",
    "events"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "case_status": {"type": "string", "enum": ["OPEN", "HOLD", "CLOSED"]},
    "jurisdiction": {"type": "string", "minLength": 2},
    "target_user": {"type": ["string", "null"]},
    "practice_context": {"type": "object", "additionalProperties": true},

    "citizen_problem_verbatim": {"type": "string", "minLength": 1},
    "citizen_goal": {"type": "string", "minLength": 1},
    "goal_state": {"type": "string", "enum": ["PROVISIONAL", "USER_SUPPLIED", "CONFIRMED"]},
    "citizen_constraints": {"type": "array", "items": {"type": "string"}},

    "ai_structured_problem": {"type": ["string", "null"]},
    "disciplinary_problem": {"type": ["string", "null"]},
    "meaning_preservation_state": {
      "type": "string",
      "enum": ["PASS", "HOLD_UNKNOWN", "FAIL", "NOT_CHECKED"]
    },
    "problem_signature": {"type": "object", "additionalProperties": true},

    "observations": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "risk_state": {"type": ["string", "null"]},
    "risk_profile": {"type": "object", "additionalProperties": true},

    "current_phase": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11"]
    },
    "current_decision": {"type": "string", "minLength": 1},
    "next_decision": {"type": ["string", "null"]},

    "primary_thread_id": {"type": "string", "pattern": "^td-[a-f0-9]{16}$"},
    "decision_threads": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "additionalProperties": true}
    },

    "requested_capability": {"type": ["string", "null"]},
    "why_capability_is_needed": {"type": ["string", "null"]},
    "current_actor": {"type": ["string", "null"]},
    "current_institution": {"type": ["string", "null"]},
    "external_actor_used": {"type": "boolean"},
    "decision_owner": {"type": ["string", "null"]},

    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "HOLD_UNKNOWN", "FAIL"]},
        "scope": {"type": "array", "items": {"type": "string"}},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },

    "allowed_data_use": {"type": "array", "items": {"type": "string"}},
    "publication_permission": {"type": "string", "enum": ["ALLOWED", "NOT_ALLOWED", "CONDITIONAL", "UNKNOWN"]},
    "commercial_use_permission": {"type": "string", "enum": ["ALLOWED", "NOT_ALLOWED", "CONDITIONAL", "UNKNOWN"]},

    "experience_provenance": {"type": "array", "items": {"type": "string"}},
    "inventorship_state": {"type": ["string", "null"]},
    "authorship_state": {"type": ["string", "null"]},
    "ip_state": {"type": ["string", "null"]},
    "benefit_sharing_state": {"type": ["string", "null"]},

    "previous_actions": {"type": "array", "items": {"type": "string"}},
    "previous_results": {"type": "array", "items": {"type": "string"}},
    "failed_routes": {"type": "array", "items": {"type": "string"}},

    "case_steward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steward_id", "authority_scope"],
      "properties": {
        "steward_id": {"type": "string", "minLength": 1},
        "host_institution": {"type": ["string", "null"]},
        "authority_scope": {"type": "array", "items": {"type": "string"}}
      }
    },

    "expected_return": {"type": ["string", "null"]},
    "response_deadline": {"type": ["string", "null"], "format": "date-time"},
    "decision_window": {"type": ["string", "null"]},
    "known_cost": {"type": ["number", "null"], "minimum": 0},
    "currency": {"type": ["string", "null"], "minLength": 3, "maxLength": 3},
    "fallback_route": {"type": ["string", "null"]},

    "latest_return_gate": {
      "type": "string",
      "enum": ["NOT_APPLICABLE", "PASS", "HOLD_UNKNOWN", "FAIL"]
    },
    "outcome_state": {
      "type": "string",
      "enum": ["ongoing", "resolved", "improved", "safely_held", "explicitly_rescoped_with_consent", "worsened", "unknown"]
    },

    "return_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"const": true},
        "return_format": {"type": ["string", "null"]},
        "return_to": {"type": ["string", "null"]}
      }
    },

    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["event_id", "event_type", "occurred_at", "actor", "payload"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^ev-[a-f0-9]{16}$"},
          "event_type": {"type": "string"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string"},
          "payload": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}
