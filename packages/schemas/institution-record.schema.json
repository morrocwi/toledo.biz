{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toledo.biz/schemas/institution-record.schema.json",
  "title": "Toledo Institution Capability Record",
  "description": "A capability-bearing institution or public-service mechanism used for Toledo routing. Identity, availability, authority and provenance are represented separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution_id",
    "institution_name",
    "mechanism_name",
    "institution_class",
    "phase_fit",
    "citizen_accessibility",
    "capability",
    "entry_channel",
    "source_url",
    "last_verified"
  ],
  "properties": {
    "record_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "record_status": {
      "type": "string",
      "enum": ["active", "unknown", "inactive", "superseded", "archived", "historical"]
    },
    "institution_id": {"type": "string", "minLength": 1},
    "institution_name": {"type": "string", "minLength": 1},
    "mechanism_name": {"type": "string", "minLength": 1},
    "country": {"type": "string", "minLength": 2},
    "jurisdiction": {"type": ["string", "null"]},
    "institution_class": {
      "type": "string",
      "enum": ["I0", "I1", "I2", "I3", "I4", "I5", "I6", "I7", "I8", "I9"]
    },
    "phase_fit": {
      "type": "array",
      "items": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "target_user": {"type": "array", "items": {"type": "string"}},
    "citizen_accessibility": {"type": "string", "enum": ["A0", "A1", "A2", "A3", "A4"]},
    "eligibility": {"type": "array", "items": {"type": "string"}},
    "entry_channel": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "capability": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "capability_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "uniqueItems": true
    },
    "service_type": {"type": "array", "items": {"type": "string"}},
    "delivery_modes": {
      "type": "array",
      "items": {"type": "string", "enum": ["online", "in-person", "hybrid", "field", "phone", "mail-or-sample", "unknown"]},
      "uniqueItems": true
    },
    "languages": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "uniqueItems": true
    },
    "geographic_coverage": {"type": ["string", "null"]},
    "price_or_cofunding": {"type": ["string", "null"]},
    "turnaround_if_known": {"type": ["string", "null"]},
    "application_window_if_any": {"type": ["string", "null"]},
    "legal_authority_if_any": {"type": ["string", "null"]},
    "accreditation_if_any": {"type": ["string", "null"]},
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["open", "closed", "call-dependent", "capacity-dependent", "unknown"]
        },
        "as_of": {"type": ["string", "null"], "format": "date"},
        "next_review": {"type": ["string", "null"], "format": "date"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": {"type": ["string", "null"], "format": "uri"},
        "email": {"type": ["string", "null"], "format": "email"},
        "phone": {"type": ["string", "null"]},
        "address": {"type": ["string", "null"]}
      }
    },
    "evidence_of_activity": {"type": "array", "items": {"type": "string"}},
    "source_url": {"type": "string", "format": "uri"},
    "source_urls": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {"type": "string", "enum": ["V0", "V1", "V2", "V3"]},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_by": {"type": ["string", "null"]},
        "evidence_urls": {
          "type": "array",
          "items": {"type": "string", "format": "uri"},
          "uniqueItems": true
        },
        "notes": {"type": ["string", "null"]}
      }
    },
    "last_verified": {"type": "string", "format": "date"},
    "fallback_routes": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "maintainer": {"type": ["string", "null"]},
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "notes": {"type": ["string", "null"]}
  }
}
