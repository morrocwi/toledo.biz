{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toledo.biz/schemas/decision-thread.schema.json",
  "title": "Toledo Decision Thread",
  "description": "One decision-specific subgraph inside a persistent Case Passport. P0-P11 semantics are preserved; threads allow one real-life case to carry several concurrent decisions at different phases without collapsing them into one maturity state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "thread_id",
    "decision",
    "phase",
    "status",
    "required_for_case_closure",
    "depends_on",
    "blocking_threads",
    "observations",
    "unknowns",
    "hypotheses",
    "risk_profile",
    "risk_state",
    "external_actor_used",
    "latest_return_gate",
    "outcome_state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "thread_id": {"type": "string", "pattern": "^td-[a-f0-9]{16}$"},
    "decision": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "enum": ["P0","P1","P2","P3","P4","P5","P6","P7","P8","P9","P10","P11"]},
    "status": {"type": "string", "enum": ["OPEN","HOLD","BLOCKED","CLOSED","CANCELLED"]},
    "required_for_case_closure": {"type": "boolean"},
    "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^td-[a-f0-9]{16}$"}, "uniqueItems": true},
    "blocking_threads": {"type": "array", "items": {"type": "string", "pattern": "^td-[a-f0-9]{16}$"}, "uniqueItems": true},
    "problem_signature": {"type": ["object", "null"], "additionalProperties": true},
    "observations": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "risk_profile": {"type": "object", "additionalProperties": true},
    "risk_state": {"type": "string", "enum": ["NO_HARD_TRIGGER","HARD_ESCALATION"]},
    "requested_capability": {"type": ["string", "null"]},
    "why_capability_is_needed": {"type": ["string", "null"]},
    "decision_owner": {"type": ["string", "null"]},
    "current_institution": {"type": ["string", "null"]},
    "external_actor_used": {"type": "boolean"},
    "latest_return_gate": {"type": "string", "enum": ["NOT_APPLICABLE","PASS","HOLD_UNKNOWN","FAIL"]},
    "outcome_state": {"type": "string", "enum": ["ongoing","resolved","improved","safely_held","explicitly_rescoped_with_consent","worsened","unknown"]},
    "previous_actions": {"type": "array", "items": {"type": "string"}},
    "previous_results": {"type": "array", "items": {"type": "string"}},
    "failed_routes": {"type": "array", "items": {"type": "string"}},
    "domain_overlay_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
